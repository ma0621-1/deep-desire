# ===== 支付宝开放平台配置 =====
# 在 https://open.alipay.com 选择「网页应用」并开通「AI 网页应用收款」（接口 alipay.trade.page.pay）
# 沙箱测试：https://open.alipay.com/develop/sandbox 创建沙箱应用，网关填沙箱地址
ALIPAY_APP_ID=
# 应用私钥（PEM 格式；.env 中可写为一行并用 \n 表示换行，也可直接写多行）
ALIPAY_PRIVATE_KEY=
# 支付宝公钥（开放平台「密钥管理」→ 查看支付宝公钥）
# 密钥支持多种粘贴形式：标准多行 PEM、单行带 BEGIN/END 头、或纯 base64 无头；PKCS1/PKCS8 均可，代码会自动归一化
ALIPAY_PUBLIC_KEY=
# 网关：生产 https://openapi.alipay.com/gateway.do ；沙箱 https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# ===== 业务参数 =====
PORT=3000
# 报告价格（元）
PRODUCT_PRICE=5.90
# 支付成功回跳地址（可选，默认 http://localhost:3000/api/pay/return）
ALIPAY_RETURN_URL=
# 异步通知地址（生产必须为公网 HTTPS；本地留空，靠回跳 + 状态查询验收）
ALIPAY_NOTIFY_URL=
